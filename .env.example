DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/audiobooker"
AUTH_SECRET="generate-a-random-secret"
AUTH_URL="http://localhost:3000"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_ENDPOINT=""

# TTS providers. Standard (Edge) is the default for everyone; premium
# providers stay off until FEATURE_PREMIUM_TTS=true, and are then offered
# to signed-in accounts that pay with premium minutes.
FEATURE_EDGE_TTS="true"
FEATURE_PREMIUM_TTS="false"
FEATURE_MINIMAX_TTS="true"
EDGE_TTS_MAX_CONCURRENCY="2"
EDGE_TTS_MAX_CHARS_PER_REQUEST="3000"
MINIMAX_MAX_CONCURRENCY="2"
OPENAI_API_KEY=""
OPENAI_TTS_MODEL="tts-1"
REPLICATE_API_TOKEN=""
REPLICATE_TTS_PREVIEW_MODEL="minimax/speech-2.8-turbo"
REPLICATE_TTS_GENERATE_MODEL="minimax/speech-2.8-hd"
REPLICATE_HD_PRICE_PER_1K_CHARS="0.1"
REPLICATE_TURBO_PRICE_PER_1K_CHARS="0.06"

# TTS quotas and cost protection. Signed-in fair use and premium minutes are
# set per plan in lib/billing/plans.ts. The anonymous allowance is a lifetime
# total per free-tool session. EDGE_GLOBAL_DAILY_CHARS="0" disables the
# site-wide cap.
ANONYMOUS_TTS_SESSION_CHARS="100000"
ANONYMOUS_IP_DAILY_CHARS="300000"
EDGE_GLOBAL_DAILY_CHARS="50000000"
IP_HASH_SALT="generate-a-random-salt"
MAX_TTS_JOB_COST_USD="10"
DAILY_PREMIUM_COST_LIMIT_USD="100"
TTS_CACHE_RETENTION_DAYS="30"

FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"
EXPORT_RETENTION_DAYS="7"
EXPORT_FFMPEG_TIMEOUT_MS="900000"
MAX_CONCURRENT_EXPORT_JOBS_PER_USER="1"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
CRON_SECRET=""
MAX_ANONYMOUS_PROJECTS="1"
MAX_ANONYMOUS_FILE_SIZE="10485760"
MAX_ANONYMOUS_PREVIEW_HOURLY="5"
MAX_ANONYMOUS_EXPORTS="1"
MAX_ANONYMOUS_CONCURRENT_JOBS="1"
ANONYMOUS_PROJECT_TTL_DAYS="3"
ANONYMOUS_RATE_LIMIT="10"
ANONYMOUS_RATE_WINDOW_MS="600000"

# Billing (Waffo Pancake). WAFFO_ENVIRONMENT is "test" or "prod" and selects
# the webhook verification key. The private key is a secret: server only,
# never commit it. List product IDs with `npm run billing:waffo-products`.
WAFFO_ENVIRONMENT="test"
WAFFO_MERCHANT_ID=""
WAFFO_STORE_ID=""
WAFFO_PRIVATE_KEY=""
WAFFO_PRODUCT_CREATOR=""
WAFFO_PRODUCT_SHORT=""
WAFFO_PRODUCT_SHORT_CREATOR=""
WAFFO_PRODUCT_BOOK=""
WAFFO_PRODUCT_BOOK_CREATOR=""
WAFFO_PRODUCT_SERIES=""
WAFFO_PRODUCT_SERIES_CREATOR=""
