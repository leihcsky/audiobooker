generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  DRAFT
  PROCESSING
  READY
  ARCHIVED
  FAILED
}

enum SourceType {
  EPUB
  PDF
  TXT
  DOCX
}

enum SourceFileStatus {
  UPLOADING
  UPLOADED
  PARSING
  PARSED
  FAILED
  DELETED
}

enum ChapterStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

enum JobType {
  PARSE_SOURCE
  GENERATE_TTS
  GENERATE_PROJECT
  GENERATE_PREVIEW
  EXPORT_MP3
  EXPORT_M4B
  EXPORT_ZIP
  MASTER_AUDIO
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum AudioType {
  CHAPTER_AUDIO
  PREVIEW
  UPLOAD
  MASTER
  EXPORT
}

enum AudioFormat {
  MP3
  WAV
  M4A
}

enum TtsTier {
  STANDARD
  PREMIUM
}

enum UsageType {
  TTS_CHARACTERS
  PREMIUM_TTS_CHARACTERS
  AUDIO_SECONDS
  EXPORT
  STORAGE_BYTES
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum CreditBucket {
  MONTHLY
  PURCHASED
}

enum CreditEntryType {
  MONTHLY_GRANT
  PURCHASE
  GENERATION_RESERVE
  GENERATION_REFUND
  PURCHASE_REVERSAL
  PROMOTION
  ADMIN_ADJUSTMENT
}

enum CreditReservationStatus {
  RESERVED
  CAPTURED
  RELEASED
}

enum BillingOrderKind {
  SUBSCRIPTION
  MINUTE_PACK
}

enum BillingOrderStatus {
  PENDING
  PAID
  REFUNDED
}

enum BillingEventOutcome {
  PROCESSED
  IGNORED
}

enum ExportType {
  MP3
  M4B
  ZIP
}

enum ExportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

model User {
  id            String    @id @default(uuid()) @db.Char(36)
  email         String    @unique @db.VarChar(255)
  emailVerified DateTime?
  name          String?   @db.VarChar(255)
  image         String?   @db.VarChar(1024)
  passwordHash  String?   @db.VarChar(255)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  projects           Project[]
  usageRecords       UsageRecord[]
  toolEvents         ToolEvent[]
  subscriptions      Subscription[]
  creditEntries      CreditLedger[]
  creditReservations CreditReservation[]
  billingOrders      BillingOrder[]

  @@index([createdAt])
}

model Account {
  userId            String  @db.Char(36)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String   @db.Char(36)
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model AnonymousSession {
  id         String   @id @default(uuid()) @db.Char(36)
  tokenHash  String   @unique @db.VarChar(128)
  ipHash     String?  @db.Char(64)
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())

  projects     Project[]
  usageRecords UsageRecord[]
  toolEvents   ToolEvent[]

  @@index([expiresAt])
  @@index([ipHash])
}

model Project {
  id                  String        @id @default(uuid()) @db.Char(36)
  userId              String?       @db.Char(36)
  anonymousSessionId  String?       @db.Char(36)
  expiresAt           DateTime?
  title               String        @db.VarChar(255)
  titleSetByUser      Boolean       @default(false)
  author              String?       @db.VarChar(255)
  description         String?       @db.Text
  language            String        @default("en") @db.VarChar(20)
  narrator            String?       @db.VarChar(255)
  publisher           String?       @db.VarChar(255)
  copyright           String?       @db.VarChar(255)
  status              ProjectStatus @default(DRAFT)
  coverObjectKey      String?       @db.VarChar(1024)
  coverWidth          Int?
  coverHeight         Int?
  aiDisclosure        String?       @db.Text
  deletedAt           DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  user              User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  anonymousSession  AnonymousSession?  @relation(fields: [anonymousSessionId], references: [id], onDelete: Cascade)
  sourceFiles       SourceFile[]
  chapters          Chapter[]
  pronunciations    PronunciationEntry[]
  generationJobs    GenerationJob[]
  audioFiles        AudioFile[]
  usageRecords      UsageRecord[]
  exports           Export[]

  @@index([userId, updatedAt])
  @@index([userId, status])
  @@index([anonymousSessionId, createdAt])
  @@index([expiresAt])
  @@index([createdAt])
}

model SourceFile {
  id               String           @id @default(uuid()) @db.Char(36)
  projectId        String           @db.Char(36)
  type             SourceType
  originalFilename String           @db.VarChar(512)
  objectKey        String           @db.VarChar(1024)
  mimeType         String           @db.VarChar(255)
  sizeBytes        BigInt
  checksum         String?          @db.VarChar(128)
  status           SourceFileStatus @default(UPLOADED)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([projectId, status])
}

model Chapter {
  id                 String        @id @default(uuid()) @db.Char(36)
  projectId          String        @db.Char(36)
  title              String        @db.VarChar(500)
  orderIndex         Int
  sourceText         String        @db.LongText
  characterCount     Int           @default(0)
  status             ChapterStatus @default(PENDING)
  selectedVoiceId    String?       @db.VarChar(255)
  selectedSpeed      Decimal       @default(1.00) @db.Decimal(3, 2)
  included           Boolean       @default(true)
  currentAudioFileId String?       @unique @db.Char(36)
  audioOutdated      Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  currentAudioFile AudioFile?      @relation("ChapterCurrentAudio", fields: [currentAudioFileId], references: [id], onDelete: SetNull)
  audioFiles       AudioFile[]     @relation("ChapterAudioFiles")
  generationJobs   GenerationJob[]

  @@unique([projectId, orderIndex])
  @@index([projectId, orderIndex])
  @@index([projectId, status])
}

model PronunciationEntry {
  id            String   @id @default(uuid()) @db.Char(36)
  projectId     String   @db.Char(36)
  term          String   @db.VarChar(100)
  replacement   String   @db.VarChar(200)
  caseSensitive Boolean  @default(false)
  wholeWord     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, term])
}

model GenerationJob {
  id              String    @id @default(uuid()) @db.Char(36)
  projectId       String    @db.Char(36)
  chapterId       String?   @db.Char(36)
  parentJobId     String?   @db.Char(36)
  type            JobType
  status          JobStatus @default(QUEUED)
  provider        String?   @db.VarChar(100)
  providerModel   String?   @db.VarChar(100)
  tier            TtsTier?
  voiceId         String?   @db.VarChar(255)
  inputCharacters Int?
  totalChunks     Int?
  completedChunks Int       @default(0)
  cachedChunks    Int       @default(0)
  retryParagraphs Json?
  estimatedCost   Decimal?  @db.Decimal(12, 4)
  actualCost      Decimal?  @db.Decimal(12, 4)
  currency        String?   @db.VarChar(3)
  errorCode       String?   @db.VarChar(100)
  errorMessage    String?   @db.Text
  attempts        Int       @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapter    Chapter?        @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  parentJob  GenerationJob?  @relation("JobChildren", fields: [parentJobId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  childJobs  GenerationJob[] @relation("JobChildren")
  audioFiles AudioFile[]
  exports    Export[]
  creditReservation CreditReservation?

  @@index([projectId, createdAt])
  @@index([chapterId, createdAt])
  @@index([status, createdAt])
  @@index([parentJobId])
}

model AudioFile {
  id              String      @id @default(uuid()) @db.Char(36)
  projectId       String      @db.Char(36)
  chapterId       String?     @db.Char(36)
  type            AudioType
  objectKey       String      @db.VarChar(1024)
  format          AudioFormat
  mimeType        String?     @db.VarChar(255)
  durationSeconds Decimal?    @db.Decimal(12, 3)
  sizeBytes       BigInt?
  sampleRate      Int?
  bitrate         Int?
  provider        String?     @db.VarChar(100)
  providerVoiceId String?     @db.VarChar(255)
  generationJobId String?     @db.Char(36)
  version         Int         @default(1)
  segmentManifest Json?
  createdAt       DateTime    @default(now())

  project           Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapter           Chapter?       @relation("ChapterAudioFiles", fields: [chapterId], references: [id], onDelete: Cascade)
  generationJob     GenerationJob? @relation(fields: [generationJobId], references: [id], onDelete: SetNull)
  currentForChapter Chapter?       @relation("ChapterCurrentAudio")

  @@index([chapterId, createdAt])
  @@index([projectId, createdAt])
}

model UsageRecord {
  id                  String    @id @default(uuid()) @db.Char(36)
  userId              String?   @db.Char(36)
  anonymousSessionId  String?   @db.Char(36)
  projectId           String?   @db.Char(36)
  jobId               String?   @db.Char(36)
  type                UsageType
  quantity            Decimal   @db.Decimal(18, 4)
  unit                String    @db.VarChar(30)
  provider            String?   @db.VarChar(100)
  periodStart         DateTime
  periodEnd           DateTime
  metadata            Json?
  createdAt           DateTime  @default(now())

  user             User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  anonymousSession AnonymousSession?  @relation(fields: [anonymousSessionId], references: [id], onDelete: Cascade)
  project          Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, type, periodStart])
  @@index([userId, createdAt])
  @@index([anonymousSessionId, type, createdAt])
}

model TtsCacheEntry {
  id              String   @id @default(uuid()) @db.Char(36)
  cacheKey        String   @unique @db.Char(64)
  provider        String   @db.VarChar(100)
  providerModel   String   @db.VarChar(100)
  providerVoiceId String   @db.VarChar(255)
  textHash        String   @db.Char(64)
  characters      Int
  objectKey       String   @db.VarChar(1024)
  sizeBytes       BigInt
  durationSeconds Decimal? @db.Decimal(12, 3)
  hitCount        Int      @default(0)
  createdAt       DateTime @default(now())
  lastUsedAt      DateTime @default(now())

  @@index([lastUsedAt])
}

model ToolEvent {
  id                  String   @id @default(uuid()) @db.Char(36)
  anonymousSessionId  String?  @db.Char(36)
  userId              String?  @db.Char(36)
  projectId           String?  @db.Char(36)
  name                String   @db.VarChar(80)
  path                String?  @db.VarChar(255)
  metadata            Json?
  createdAt           DateTime @default(now())

  user             User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  anonymousSession AnonymousSession?  @relation(fields: [anonymousSessionId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
  @@index([anonymousSessionId, createdAt])
}

model Export {
  id              String       @id @default(uuid()) @db.Char(36)
  projectId       String       @db.Char(36)
  type            ExportType
  status          ExportStatus @default(QUEUED)
  objectKey       String?      @db.VarChar(1024)
  format          String       @db.VarChar(20)
  sizeBytes       BigInt?
  durationSeconds Decimal?     @db.Decimal(12, 3)
  errorMessage    String?      @db.Text
  expiresAt       DateTime?
  createdAt       DateTime     @default(now())
  completedAt     DateTime?
  generationJobId String?      @db.Char(36)
  masteringPreset String?      @db.VarChar(50)
  qcReport        Json?

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generationJob GenerationJob? @relation(fields: [generationJobId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([status, createdAt])
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Char(36)
  userId             String             @db.Char(36)
  provider           String             @db.VarChar(50)
  customerId         String?            @db.VarChar(255)
  subscriptionId     String?            @db.VarChar(255)
  planId             String             @db.VarChar(100)
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subscriptionId])
  @@index([userId, status])
}

model CreditLedger {
  id             String          @id @default(uuid()) @db.Char(36)
  userId         String          @db.Char(36)
  type           CreditEntryType
  bucket         CreditBucket
  amountSeconds  Int
  expiresAt      DateTime?
  referenceType  String?         @db.VarChar(50)
  referenceId    String?         @db.VarChar(255)
  idempotencyKey String?         @unique @db.VarChar(191)
  metadata       Json?
  createdAt      DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, bucket, expiresAt])
  @@index([userId, createdAt])
}

model CreditReservation {
  id               String                  @id @default(uuid()) @db.Char(36)
  userId           String                  @db.Char(36)
  jobId            String?                 @unique @db.Char(36)
  status           CreditReservationStatus @default(RESERVED)
  reservedSeconds  Int
  monthlySeconds   Int                     @default(0)
  purchasedSeconds Int                     @default(0)
  monthlyExpiresAt DateTime?
  capturedSeconds  Int?
  settledAt        DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  GenerationJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([userId, status])
}

model BillingOrder {
  id                String             @id @default(uuid()) @db.Char(36)
  userId            String             @db.Char(36)
  provider          String             @db.VarChar(50)
  kind              BillingOrderKind
  itemId            String             @db.VarChar(50)
  creatorPrice      Boolean            @default(false)
  productId         String             @db.VarChar(255)
  amountUsd         Decimal            @db.Decimal(10, 2)
  premiumSeconds    Int                @default(0)
  checkoutSessionId String?            @db.VarChar(255)
  providerOrderId   String?            @db.VarChar(255)
  status            BillingOrderStatus @default(PENDING)
  paidAt            DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerOrderId])
  @@index([userId, createdAt])
}

model BillingEvent {
  id              String              @id @default(uuid()) @db.Char(36)
  provider        String              @db.VarChar(50)
  providerEventId String              @db.VarChar(191)
  eventType       String              @db.VarChar(100)
  businessEventId String?             @db.VarChar(255)
  providerOrderId String?             @db.VarChar(255)
  outcome         BillingEventOutcome
  note            String?             @db.VarChar(255)
  payloadHash     String              @db.Char(64)
  createdAt       DateTime            @default(now())

  @@unique([provider, providerEventId])
  @@index([providerOrderId])
}
